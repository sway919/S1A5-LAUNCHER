<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Dfo60US.Launcher"/>

  <!--
    DFO 60US 启动器清单 (net48):

      · asInvoker —— 【不申请管理员权限】。启动器只做本地进程与文件管理
        (拉起服务端/GM/客户端、读写 config.cfg 与存档三件套), 这些都不需要提权。
        用 requireAdministrator 的话每次开启动器都会弹一次 UAC, 而服务端本身
        也是以普通权限在跑的 —— 提权只会让"启动器启动的服务端"和玩家自己双击
        start-server.cmd 起来的服务端处于不同的权限/会话环境, 反而更难排查问题。
        (服务端包《使用说明》本来就要求解压到"有写入权限的目录", 所以按普通
         权限运行是符合它自身约定的。)
        如果你的服务端/客户端放在需要提权的目录里, 把下面 level 改成
        requireAdministrator 即可。

      · dpiAware=true —— 系统级 DPI 感知 (Win7 也支持的最高档)。
      · supportedOS 列出 Win7 及以上, 让 GetVersionEx 返回真实版本号。
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" /> <!-- Windows Vista / 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" /> <!-- Windows 7 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" /> <!-- Windows 8 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" /> <!-- Windows 8.1 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" /> <!-- Windows 10 / 11 -->
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
