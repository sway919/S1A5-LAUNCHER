<!--
    ══════════════════════════════════════════════════════════════
    主题令牌 · 深色 — 配色取自背景原画 (DNF 2009-02 挂历壁纸 · 六职业)

    这张原画: 六个职业竖条 (鬼剑/法师/女枪/枪手/格斗/圣职), 暖色主导 ——
    红橙占 79%、绿 5%、蓝 8%、紫 5%, 底色近黑, 最底下一段几乎全黑。

    设计语言的三个决定:
      1. 强调色 = 青蓝 #7BD4DF —— 由 ArtPalette 从原画实时算出来的:
         主色相 26° (那条暖红橙) 落在"危险色保留带"里, 于是按和声模板取
         互补 → 206°, 也正好是画面里剑刃/冰蓝那一侧的冷色。用于:
         选中态 / 图标 / 焦点环 / 进度 / 次级行动按钮。
      2. 主行动色 = 金 #D59B33 系 —— 来自 DNF 标志与圣职那条金十字。
         【开始游戏】是全局唯一的金色实心按钮, 一眼锁定。
      3. 表面 = 暖黑玻璃 (低色度、半透明) + 1px 发丝描边, 让原画透出来。
         色相跟着原画走 (26° 暖), 所以面板是"暖黑"而不是冷蓝灰。

    【这里的色值怎么来的】下面每个令牌都是 tests\PaletteProbe 拿这张图 +
    Core\ArtPalette 实算出来的结果 —— 有背景图时运行算什么, 没背景图时的
    兜底值就是什么, 两条路一致。换默认背景图后重跑一遍探针再抄过来。

    说明: 所有键在 Brushes.Light.xaml 中一一对应, 运行时整体替换 [1] 号字典。
    ══════════════════════════════════════════════════════════════
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 背景基色 / 光晕 / 压暗 (没有背景图时铺的那层底色) ===== -->
    <Color x:Key="C.Bd1">#FF151518</Color>
    <Color x:Key="C.Bd2">#FF232427</Color>
    <Color x:Key="C.Bd3">#FF0D0D0D</Color>
    <Color x:Key="C.GlowA">#2EAEC6FF</Color>
    <Color x:Key="C.GlowB">#24EABB66</Color>
    <Color x:Key="C.Vig">#70000000</Color>

    <SolidColorBrush x:Key="Brush.WindowBg"    Color="#0B0809"/>
    <!-- 原画不被整体覆盖: 色纱仅用于标题带/底部的渐隐压暗 (见下)。
         浓度跟设置里的"上下渐隐浓度" (UiScrimOpacity, 默认 30%) 一致。 -->
    <LinearGradientBrush x:Key="Brush.ScrimTopGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4C1B1919" Offset="0"/>
        <GradientStop Color="#2E1B1919" Offset="0.45"/>
        <GradientStop Color="#001B1919" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ScrimBotGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#001B1919" Offset="0"/>
        <GradientStop Color="#461B1919" Offset="0.6"/>
        <GradientStop Color="#4C1B1919" Offset="1"/>
    </LinearGradientBrush>
    <!-- 内容页/弹窗压暗层底色 (配 Opacity 使用) -->
    <SolidColorBrush x:Key="Brush.ShadeSolid"  Color="#FF101113"/>
    <SolidColorBrush x:Key="Brush.FadeSolid"   Color="#FF0D0E10"/>
    <!-- 背景装饰圆环 -->
    <SolidColorBrush x:Key="Brush.DecoRing"    Color="#14FFFFFF"/>

    <!-- ===== 表面 (面板) ===== -->
    <SolidColorBrush x:Key="Brush.Glass"        Color="#9E19191C"/>
    <SolidColorBrush x:Key="Brush.GlassStrong"  Color="#B8212124"/>
    <SolidColorBrush x:Key="Brush.GlassHover"   Color="#C72A2A2B"/>
    <SolidColorBrush x:Key="Brush.GlassPress"   Color="#AD323235"/>
    <SolidColorBrush x:Key="Brush.GlassBorder"  Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GlassBorderHot" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="Brush.HoverSoft"    Color="#17EAE7EA"/>
    <SolidColorBrush x:Key="Brush.Sep"          Color="#1AEAE7E9"/>
    <!-- 浮动面板底: 上亮下暗, 制造厚度。透明度压到 62% (面板不透明度设置),
         让原画在玻璃后面透出来 (再低就会糊掉面板上的文字) -->
    <LinearGradientBrush x:Key="Brush.GlassGrad" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#A31C1C1F" Offset="0"/>
        <GradientStop Color="#9E1A1A1D" Offset="0.25"/>
        <GradientStop Color="#9918181B" Offset="0.5"/>
        <GradientStop Color="#9417171A" Offset="0.75"/>
        <GradientStop Color="#8F151518" Offset="1"/>
    </LinearGradientBrush>
    <!-- 玻璃边缘: 上亮下暗的描边, 模拟玻璃受光的一圈高光 -->
    <LinearGradientBrush x:Key="Brush.GlassEdge" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Color="#38FCF8FA" Offset="0"/>
        <GradientStop Color="#2EF6F2F4" Offset="0.25"/>
        <GradientStop Color="#24F0EDEE" Offset="0.5"/>
        <GradientStop Color="#1AEBE7E8" Offset="0.75"/>
        <GradientStop Color="#10E5E2E2" Offset="1"/>
    </LinearGradientBrush>
    <!-- 面板左上角的一束光 (玻璃受光) -->
    <RadialGradientBrush x:Key="Brush.CardSheen" GradientOrigin="0.12,0" Center="0.12,0"
                         RadiusX="0.9" RadiusY="0.75">
        <GradientStop Color="#17FFFCFB" Offset="0"/>
        <GradientStop Color="#00FFFCFB" Offset="1"/>
    </RadialGradientBrush>

    <!-- ===== 文本 (色相跟原画走: 26° 暖白, 不是冷白) ===== -->
    <SolidColorBrush x:Key="Brush.Text"   Color="#FFEBE7E8"/>
    <SolidColorBrush x:Key="Brush.Text2"  Color="#FFC2C0C2"/>
    <SolidColorBrush x:Key="Brush.Text3"  Color="#FF8D8B8C"/>

    <!-- ===== 强调色: 青蓝 (选中 / 图标 / 焦点) ===== -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FFAEC6FF"/>
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FFC6D7FF"/>
    <SolidColorBrush x:Key="Brush.AccentPress"  Color="#FF98B0E9"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#4D434751"/>
    <SolidColorBrush x:Key="Brush.AccentLine"   Color="#8AAEC6FF"/>
    <SolidColorBrush x:Key="Brush.AccentText"   Color="#FFB3C6F6"/>
    <SolidColorBrush x:Key="Brush.OnAccent"     Color="#FF283044"/>

    <!-- ===== 主行动色: 金 (仅【开始游戏】) ===== -->
    <LinearGradientBrush x:Key="Brush.HeroFill" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#FFFFDB92" Offset="0"/>
        <GradientStop Color="#FFF5CB7C" Offset="0.25"/>
        <GradientStop Color="#FFEABB66" Offset="0.5"/>
        <GradientStop Color="#FFE0AB4E" Offset="0.75"/>
        <GradientStop Color="#FFD59B33" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeroFillHot" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#FFFFF1DF" Offset="0"/>
        <GradientStop Color="#FFFAE0BB" Offset="0.25"/>
        <GradientStop Color="#FFF4CF97" Offset="0.5"/>
        <GradientStop Color="#FFEEBD70" Offset="0.75"/>
        <GradientStop Color="#FFE8AB42" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeroFillPress" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#FFF5C478" Offset="0"/>
        <GradientStop Color="#FFE7B464" Offset="0.25"/>
        <GradientStop Color="#FFD9A550" Offset="0.5"/>
        <GradientStop Color="#FFCB9539" Offset="0.75"/>
        <GradientStop Color="#FFBD861E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.OnHero"   Color="#2B1B03"/>
    <SolidColorBrush x:Key="Brush.HeroLine" Color="#7AE9B259"/>

    <!-- ===== 语义色 (角色保留: 不跟原画走, 免得跟"主行动/强调"混在一起) ===== -->
    <SolidColorBrush x:Key="Brush.Danger"       Color="#E8555F"/>
    <SolidColorBrush x:Key="Brush.DangerHover"  Color="#F4737B"/>
    <SolidColorBrush x:Key="Brush.DangerSoft"   Color="#33E8555F"/>
    <SolidColorBrush x:Key="Brush.OnDanger"     Color="#2B0A0D"/>
    <SolidColorBrush x:Key="Brush.Warn"         Color="#F2C46B"/>
    <SolidColorBrush x:Key="Brush.WarnSoft"     Color="#33F2C46B"/>
    <SolidColorBrush x:Key="Brush.OnWarn"       Color="#2A1C03"/>
    <SolidColorBrush x:Key="Brush.Info"         Color="#7FD4F2"/>
    <SolidColorBrush x:Key="Brush.Scroll"       Color="#4DE4E2E3"/>

    <!-- ===== 输入 / 进度 ===== -->
    <SolidColorBrush x:Key="Brush.FieldFill"    Color="#1CF6F3F4"/>
    <SolidColorBrush x:Key="Brush.FieldBorder"  Color="#2EE5E2E2"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#2EE4E2E3"/>

    <!-- ===== 徽标 (DLL 强制启用等) ===== -->
    <SolidColorBrush x:Key="Brush.BadgeFill"    Color="#3D434751"/>
    <SolidColorBrush x:Key="Brush.BadgeLine"    Color="#70AEC6FF"/>

    <!-- ===== 标题栏 (chrome) 令牌 =====
         这组颜色与页面主题解耦: 只由"原画标题带是深是浅"决定 (见 Core/ArtPalette)。
         这张图的标题带是深的 (顶部只有 L*≈18), 所以是深底 + 浅字。
         运行时会自适应注入, 这里是没有背景图时的兜底。 -->
    <SolidColorBrush x:Key="Brush.ChromeFg"     Color="#FFF7F3F2"/>
    <SolidColorBrush x:Key="Brush.ChromeFg2"    Color="#FFC9C6C5"/>
    <SolidColorBrush x:Key="Brush.ChromeFg3"    Color="#FF939090"/>
    <SolidColorBrush x:Key="Brush.ChromeHover"  Color="#1AF4F0EF"/>
    <SolidColorBrush x:Key="Brush.ChromeSep"    Color="#24F4F0EF"/>
    <SolidColorBrush x:Key="Brush.ChromeCapsule" Color="#C61C1B1B"/>
    <SolidColorBrush x:Key="Brush.ChromeCapsuleBorder" Color="#26F4F0EF"/>
    <SolidColorBrush x:Key="Brush.ChromeAccent" Color="#FFCFCBCA"/>
    <SolidColorBrush x:Key="Brush.ChromeAccentSoft" Color="#33C9C6C5"/>
    <SolidColorBrush x:Key="Brush.ChromeAccentLine" Color="#8ACFCBCA"/>
    <!-- ===== 标题栏端部渐变底 (品牌区 / 状态与窗口按钮区) =====
         从边缘向中间渐隐, 让标题与按钮从原画上浮起来。
         运行时会由 ArtPalette.ApplyEnvironment 按标题带的明暗重算, 这里是没有背景图时的兜底。 -->
    <LinearGradientBrush x:Key="Brush.ChromeBarLeft" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E01C1B1B" Offset="0"/>
        <GradientStop Color="#9E1C1B1B" Offset="0.5"/>
        <GradientStop Color="#001C1B1B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ChromeBarRight" StartPoint="1,0" EndPoint="0,0">
        <GradientStop Color="#E01C1B1B" Offset="0"/>
        <GradientStop Color="#9E1C1B1B" Offset="0.5"/>
        <GradientStop Color="#001C1B1B" Offset="1"/>
    </LinearGradientBrush>

    <!-- 品牌标记 (闪电圆章) -->
    <LinearGradientBrush x:Key="Brush.MarkGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB7CCFF" Offset="0"/>
        <GradientStop Color="#FFA8BEF2" Offset="0.25"/>
        <GradientStop Color="#FF9AB0E5" Offset="0.5"/>
        <GradientStop Color="#FF8BA3D9" Offset="0.75"/>
        <GradientStop Color="#FF7D95CC" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== 日志控制台 —— 明暗主题下都保持深底 (终端观感) ===== -->
    <SolidColorBrush x:Key="Brush.LogBg"    Color="#F2151518"/>
    <SolidColorBrush x:Key="Brush.LogText"  Color="#FFE5E2E2"/>
    <SolidColorBrush x:Key="Brush.LogTime"  Color="#7C8CA0"/>
    <SolidColorBrush x:Key="Brush.LogOk"    Color="#59D9F5"/>
    <SolidColorBrush x:Key="Brush.LogWarn"  Color="#F2C46B"/>
    <SolidColorBrush x:Key="Brush.LogErr"   Color="#FF8A7E"/>
    <SolidColorBrush x:Key="Brush.LogBlue"  Color="#7FD4F2"/>
    <SolidColorBrush x:Key="Brush.LogGold"  Color="#E8B24A"/>
    <SolidColorBrush x:Key="Brush.LogGray"  Color="#93A2B4"/>

    <!-- ===== 效果 (浮动卡片投影 / 金色主按钮辉光) ===== -->
    <DropShadowEffect x:Key="Fx.CardShadow" Color="#000000" BlurRadius="30"
                      ShadowDepth="8" Direction="270" Opacity="0.55" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Fx.HeroGlow" Color="#E0AB4E" BlurRadius="20"
                      ShadowDepth="0" Opacity="0.5" RenderingBias="Performance"/>

    <!-- ===== 兼容键 (旧引用保留, 新界面不再使用) ===== -->
    <SolidColorBrush x:Key="Brush.Pill"         Color="#EFF3F7"/>
    <SolidColorBrush x:Key="Brush.PillHover"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PillText"     Color="#101418"/>
    <SolidColorBrush x:Key="Brush.PillCircle"   Color="#101418"/>
    <SolidColorBrush x:Key="Brush.TabSel"       Color="#EFF3F7"/>
    <SolidColorBrush x:Key="Brush.TabSelText"   Color="#101418"/>
</ResourceDictionary>
