<!--
    ══════════════════════════════════════════════════════════════
    Fluent 主题令牌覆盖 · 浅色

    与 Fluent.Dark.xaml 键位一一对应。旧版只有一份深色覆盖表, 切到浅色
    主题后原生控件 (下拉/滚动条/滑块/列表选择) 仍然是深色 —— 这是浅色
    主题"不好看"的主要原因之一, 现在按主题成对替换。

    色值同样来自 tests\PaletteProbe 对新原画 (DNF 2009-02 挂历壁纸) 的实算:
    强调 = 青蓝在浅底上的深色版 #006972 (白底 6.4:1), 中性面 = 暖白瓷。
    ══════════════════════════════════════════════════════════════
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 强调色 (深青, 白字 5.8:1) ===== -->
    <Color x:Key="SystemAccentColor">#FF4A6396</Color>
    <Color x:Key="SystemAccentColorLight1">#FF5C73A0</Color>
    <Color x:Key="SystemAccentColorLight2">#FF6B7FA9</Color>
    <Color x:Key="SystemAccentColorLight3">#FF7D8FB3</Color>
    <Color x:Key="SystemAccentColorDark1">#FF384A70</Color>
    <Color x:Key="SystemAccentColorDark2">#FF2C3B5A</Color>
    <Color x:Key="SystemAccentColorDark3">#FF212D44</Color>

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF4A6396"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FE6A6396"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FB3A6396"/>
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#F5CA6396"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#8AFFFFFF"/>

    <!-- ===== 表面 (暖白瓷) ===== -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFEEECEE"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFE2DFE0"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F5D9D6D9"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#F5D9D6D9"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#F7FFFFFF"/>
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorBaseBrush" Color="#FAFFFFFF"/>

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFEEECEE"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1F241C1A"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#F5D9D6D9"/>

    <!-- ===== 控件填充/描边 ===== -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E8F5F0EF"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#4DF5F0EF"/>
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2B241C1A"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#1A241C1A"/>
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentTertiaryBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#72241C1A"/>
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#0A241C1A"/>
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#0F241C1A"/>
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#17241C1A"/>

    <!-- ===== 文本 ===== -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF201F20"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF535253"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7D7C7C"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C211F1F"/>
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FFFFFF"/>

    <!-- ===== 焦点/选择 ===== -->
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FF455E91"/>
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#FFFCFB"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0A241C1A"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06241C1A"/>
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#17241C1A"/>

    <!-- ===== 滚动条 ===== -->
    <SolidColorBrush x:Key="ScrollBarThumbFillBrush" Color="#33241C1A"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOverBrush" Color="#4D241C1A"/>
    <SolidColorBrush x:Key="ScrollBarTrackFillBrush" Color="#00000000"/>
</ResourceDictionary>
