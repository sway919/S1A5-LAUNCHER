<!--
    ══════════════════════════════════════════════════════════════
    Fluent 主题令牌覆盖 · 深色 (net10 WPF 官方 Fluent 主题)

    这些键名是 WinUI/WPF Fluent 主题的公共令牌名, 在此覆盖后, 所有
    基础控件 (滑块/滚动条/进度条/列表选择/焦点环/文本框) 自动跟随本
    启动器的配色 —— 否则它们会保留 Fluent 默认蓝, 与强调色打架。

    强调填充色刻意取"深青"而不是界面强调色 #7BD4DF:
    Fluent 会在强调填充上叠白字, 高饱和亮青配白字对比度不足。

    色值同样来自 tests\PaletteProbe 对新原画 (DNF 2009-02 挂历壁纸) 的实算:
    强调 = 原画主色相 26° 的互补 206° (青蓝), 中性面 = 暖黑 (不是冷蓝灰)。
    ══════════════════════════════════════════════════════════════
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 强调色 (深青, 白字 4.6:1) ===== -->
    <Color x:Key="SystemAccentColor">#FF647CB1</Color>
    <Color x:Key="SystemAccentColorLight1">#FF7489B9</Color>
    <Color x:Key="SystemAccentColorLight2">#FF8094BF</Color>
    <Color x:Key="SystemAccentColorLight3">#FF8FA1C7</Color>
    <Color x:Key="SystemAccentColorDark1">#FF4B5D85</Color>
    <Color x:Key="SystemAccentColorDark2">#FF3C4A6A</Color>
    <Color x:Key="SystemAccentColorDark3">#FF2D3850</Color>

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF647CB1"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FE647CB1"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FB347CB1"/>
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#F5C47CB1"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#8AFFFFFF"/>

    <!-- ===== 表面 (暖黑, 与玻璃面板同一套层次) ===== -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#B8212124"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#C72A2A2B"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#AD323235"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#AD323235"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#100D0C"/>

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#4D1A1514"/>
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#401A1514"/>
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#73262120"/>
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#F21E1918"/>
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorBaseBrush" Color="#F51A1514"/>

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B8212124"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#991A1615"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#AD323235"/>

    <!-- ===== 控件填充/描边 ===== -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentTertiaryBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#1AFFFFFF"/>

    <!-- ===== 文本 ===== -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFEBE7E8"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFC2C0C2"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF8D8B8C"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5CFFFCFB"/>
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#1E1918"/>

    <!-- ===== 焦点/选择 ===== -->
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFAEC6FF"/>
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#0D0A0F"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#1AFFFFFF"/>

    <!-- ===== 滚动条 ===== -->
    <SolidColorBrush x:Key="ScrollBarThumbFillBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOverBrush" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="ScrollBarTrackFillBrush" Color="#00FFFFFF"/>
</ResourceDictionary>
