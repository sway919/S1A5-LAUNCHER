<!--
    ════════════════════════════════════════════════════════════════
    S1A5 一键启动器 主窗口 (16:9) — 全窗沉浸背景 + 玻璃标题栏 + 内容层 + 日志胶囊 + 顶部进度线
    层次 (自下而上):
      1. 背景: 深海渐变 + 光晕 + 装饰圆环 + 双层背景图(交叉淡入) + 遮罩
      2. 暗角 (vignette) — 四角压暗, 增加纵深
      3. 顶部/底部 渐隐压暗层 — 保证标题栏与底部面板在任何图片上都清晰可读
      4. ViewHost 内容层 (首页/存档/设置/说明)
      5. 背景轮播箭头 · 顶部进度线
      6. 压暗层 FadeLayer (弹窗打开时渐暗)
      7. 标题栏 46px (品牌回首页 / 状态 / 导航 / 主题 / 窗口按钮)
      8. 日志胶囊 (折叠: 左下小胶囊; 展开: 宽日志板)
    ════════════════════════════════════════════════════════════════
-->
<Window x:Class="ServerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="pack://application:,,,/icon128.png"
        Title="S1A5 一键启动器 v1.0"
        Width="1440" Height="810" MinWidth="1080" MinHeight="608"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True"
        Drop="Win_Drop" DragOver="Win_DragOver" PreviewKeyDown="Win_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <!-- ============ 0. 背景栈 (毛玻璃面板要实时采样这一组) ============
             面板的"高斯模糊 + 半透明"= 用 VisualBrush 采样 BackdropHost 里
             面板正下方那一片, 经 BlurEffect 模糊后铺在面板底层, 再叠半透明底色。
             所以渐变/光晕/背景图/暗角/渐隐带必须同属这一组。 -->
        <Grid x:Name="BackdropHost">
            <!-- ================= 1. 背景层 ================= -->
            <Grid>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource C.Bd1}" Offset="0"/>
                            <GradientStop Color="{DynamicResource C.Bd2}" Offset="0.52"/>
                            <GradientStop Color="{DynamicResource C.Bd3}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Ellipse Width="1000" Height="700" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-200,0,0,-240">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource C.GlowA}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="820" Height="600" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-180,-160,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource C.GlowB}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="1200" Height="1200" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-470,-590" Stroke="{DynamicResource Brush.DecoRing}" StrokeThickness="1.2"/>
                <Ellipse Width="820" Height="820" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-270,-410" Stroke="{DynamicResource Brush.DecoRing}" StrokeThickness="1.2"/>

                <!-- 自定义背景图 (双层交叉淡入) -->
                <Border x:Name="BgLayerB" Opacity="0">
                    <Border.Background>
                        <ImageBrush x:Name="BgBrushB" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <Border x:Name="BgLayerA">
                    <Border.Background>
                        <ImageBrush x:Name="BgBrushA" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!-- 可调遮罩 (内容页/弹窗用, 主页恒为 0) -->
                <Border x:Name="Shade" Background="{DynamicResource Brush.ShadeSolid}" Opacity="0.35"/>
            </Grid>

            <!-- ================= 2. 暗角 ================= -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.82" RadiusY="0.88">
                        <GradientStop Color="#00000000" Offset="0.42"/>
                        <GradientStop Color="{DynamicResource C.Vig}" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- ================= 3. 渐隐压暗带 (上/下) =================
                 只压这两条带, 画面中段完全交给原画; 渐变的形状由主题决定 -->
            <Border Height="120" VerticalAlignment="Top" IsHitTestVisible="False"
                    Background="{DynamicResource Brush.ScrimTopGrad}"/>
            <Border Height="300" VerticalAlignment="Bottom" IsHitTestVisible="False"
                    Background="{DynamicResource Brush.ScrimBotGrad}"/>

        </Grid>

        <!-- ================= 4. 内容层 ================= -->
        <ContentControl x:Name="ViewHost"/>

        <!-- ================= 4.5 左侧功能栏 =================
             功能入口放在左侧竖栏 (图标 + 文字), 不再塞进顶栏 ——
             顶栏只留 品牌 / 服务端状态 / 主题 / 窗口按钮。 -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                CornerRadius="16" Background="{DynamicResource Brush.GlassGrad}"
                BorderBrush="{DynamicResource Brush.GlassEdge}" BorderThickness="1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Margin="6,8">
                <RadioButton x:Name="NavHome" Style="{StaticResource NavRail}" GroupName="nav"
                             Checked="Nav_Checked" ToolTip="首页 (Ctrl+1)">
                    <StackPanel>
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcHome}" Width="20" Height="20"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="首页" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavArc" Style="{StaticResource NavRail}" GroupName="nav"
                             Checked="Nav_Checked" ToolTip="存档管理 (Ctrl+2)">
                    <StackPanel>
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcBox}" Width="20" Height="20"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="存档" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <!-- DLL 扩展: 客户端插件管理页 (dll_ext.ini 的图形管理, 见 Services\DllExtService.cs) -->
                <RadioButton x:Name="NavDll" Style="{StaticResource NavRail}" GroupName="nav"
                             Checked="Nav_Checked" ToolTip="DLL 扩展 (Ctrl+3)">
                    <StackPanel>
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcChip}" Width="20" Height="20"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="DLL 扩展" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSet" Style="{StaticResource NavRail}" GroupName="nav"
                             Checked="Nav_Checked" ToolTip="设置 (Ctrl+4)">
                    <StackPanel>
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcGear}" Width="20" Height="20"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="设置" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavHelp" Style="{StaticResource NavRail}" GroupName="nav"
                             Checked="Nav_Checked" ToolTip="使用说明 (Ctrl+5)">
                    <StackPanel>
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcHelp}" Width="20" Height="20"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="说明" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ================= 5. 轮播箭头 + 进度线 ================= -->
        <Button x:Name="BgPrev" Style="{StaticResource ChromeIconBtn}" Width="40" Height="40" Opacity="0.6"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,34,0,0"
                Visibility="Collapsed" Click="BgPrev_Click" ToolTip="上一张背景图">
            <Path Style="{StaticResource Ico}" Data="{StaticResource IcChevL}" Width="19" Height="19"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <Button x:Name="BgNext" Style="{StaticResource ChromeIconBtn}" Width="40" Height="40" Opacity="0.6"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,34,20,0"
                Visibility="Collapsed" Click="BgNext_Click" ToolTip="下一张背景图">
            <Path Style="{StaticResource Ico}" Data="{StaticResource IcChevR}" Width="19" Height="19"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <ProgressBar x:Name="TopBar" Height="3" VerticalAlignment="Top" Visibility="Collapsed"/>

        <!-- ================= 6. 压暗层 ================= -->
        <Border x:Name="FadeLayer" Background="{DynamicResource Brush.FadeSolid}" Opacity="0" IsHitTestVisible="False"/>

        <!-- ================= 7. 标题栏 =================
             整条 48px 都能拖动窗口。
             注意: 这里的 Background 必须是"可命中的" (Transparent 而不是不写) ——
             WPF 里 Background="{x:Null}" 的元素不参与命中测试, 于是这条标题栏
             既不会触发 WindowChrome 的原生 Caption 拖动, 也收不到鼠标事件,
             表现就是"中间那片空白拖不动"。双击 = 最大化 / 还原。 -->
        <Grid Height="48" VerticalAlignment="Top"
              Background="Transparent" Cursor="SizeAll"
              MouseLeftButtonDown="Caption_Down" MouseMove="Caption_Move"
              ToolTip="按住此处可拖动窗口（双击最大化 / 还原）">

            <!-- 左右两端的渐变底: 贴边实、向中间渐隐。
                 不参与命中测试 —— 拖动由外层标题栏 Grid 统一接管。
                 左侧托住品牌标题, 右侧托住状态灯与窗口按钮, 保证在任何原画上都读得清。 -->
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="430"
                       IsHitTestVisible="False" Fill="{DynamicResource Brush.ChromeBarLeft}"/>
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="470"
                       IsHitTestVisible="False" Fill="{DynamicResource Brush.ChromeBarRight}"/>

            <!-- 拖动提示: 六点抓手 + 小玻璃底板。
                 底板用与窗口按钮胶囊同一套 chrome 令牌, 所以深/浅主题、任何背景图上
                 都看得见 —— 只画几个点在原画上, 玩家根本注意不到。 -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                    CornerRadius="6" Padding="8,5" Opacity="0.92"
                    Background="{DynamicResource Brush.ChromeCapsule}"
                    BorderBrush="{DynamicResource Brush.ChromeCapsuleBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Ellipse Grid.Row="0" Grid.Column="0" Width="3.5" Height="3.5" Margin="3" Fill="{DynamicResource Brush.ChromeFg2}"/>
                    <Ellipse Grid.Row="0" Grid.Column="1" Width="3.5" Height="3.5" Margin="3" Fill="{DynamicResource Brush.ChromeFg2}"/>
                    <Ellipse Grid.Row="1" Grid.Column="0" Width="3.5" Height="3.5" Margin="3" Fill="{DynamicResource Brush.ChromeFg2}"/>
                    <Ellipse Grid.Row="1" Grid.Column="1" Width="3.5" Height="3.5" Margin="3" Fill="{DynamicResource Brush.ChromeFg2}"/>
                    <Ellipse Grid.Row="2" Grid.Column="0" Width="3.5" Height="3.5" Margin="3" Fill="{DynamicResource Brush.ChromeFg2}"/>
                    <Ellipse Grid.Row="2" Grid.Column="1" Width="3.5" Height="3.5" Margin="3" Fill="{DynamicResource Brush.ChromeFg2}"/>
                </Grid>
            </Border>

            <!-- 品牌区: 单击回首页 (改成抬键触发, 这样从品牌上"拖"不会误跳首页) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                        Background="Transparent" Cursor="Hand" PreviewMouseLeftButtonUp="Brand_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- 品牌标记 = 程序图标 (与 exe/任务栏图标同一个文件) -->
                <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center"
                        ClipToBounds="True">
                    <Image x:Name="BrandIcon" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                    <TextBlock Text="S1A5 单机一键端" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.ChromeFg}"/>
                    <TextBlock Text="ACT5 服务端 · 网页 GM · 一键启动 · v1.0" FontSize="11.5"
                               Foreground="{DynamicResource Brush.ChromeFg2}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border CornerRadius="999" Background="Transparent" BorderThickness="0"
                        Padding="10,5" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="服务端运行状态">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StDot" Width="8" Height="8" Fill="{DynamicResource Brush.Danger}" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="StDotGlow" Color="#E8555F" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="StTxt" Text="服务端未运行" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.ChromeFg2}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button x:Name="ThemeBtn" Style="{StaticResource ChromeIconBtn}" Click="Theme_Click" ToolTip="切换明暗主题">
                    <Path x:Name="ThemeIcon" Style="{StaticResource Ico}" Data="{StaticResource IcMoon}" Width="16" Height="16"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <Border Width="1" Height="18" Background="{DynamicResource Brush.ChromeSep}" Margin="10,0,10,0"/>

                <!-- 窗口按钮胶囊 (圆角 8 玻璃容器, 与 Collapse 一致) -->
                <Border CornerRadius="8" Background="{DynamicResource Brush.ChromeCapsule}"
                        BorderBrush="{DynamicResource Brush.ChromeCapsuleBorder}" BorderThickness="1"
                        ClipToBounds="True" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ChromeWinBtn}" Click="Min_Click" ToolTip="最小化">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcMin}" Width="13" Height="13"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="BtMax" Style="{StaticResource ChromeWinBtn}" Click="Max_Click" ToolTip="最大化">
                            <Path x:Name="MaxIcon" Style="{StaticResource Ico}" Data="{StaticResource IcMax}" Width="12" Height="12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource ChromeWinBtnClose}" Click="Close_Click" ToolTip="关闭">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcClose}" Width="13" Height="13"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ================= 8. 运行日志 =================
             交互: 底部胶囊 = 展开/收起开关 (也显示进度与最后一行);
             面板从胶囊上方展开, 自带工具条 (复制 / 清空 / 收起), 尺寸固定,
             不再横跨整个窗口压住其它面板。 -->
        <!-- 位置: 右下角、指挥台正上方 (与指挥台同一列) —— 展开时往上长,
             不遮挡左侧信息板, 也不压住指挥台。170 = 指挥台高度 + 间距。 -->
        <StackPanel x:Name="LogCard" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,26,170">
            <Border x:Name="LogBody" Width="470" Height="330" Margin="0,0,0,6" CornerRadius="12"
                    Background="{DynamicResource Brush.LogBg}"
                    BorderBrush="{DynamicResource Brush.GlassEdge}" BorderThickness="1"
                    Effect="{DynamicResource Fx.CardShadow}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcCopy}" Width="14" Height="14"/>
                            <TextBlock Text="运行日志" FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.LogText}" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="LogTools" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnSmall}" Click="LogCopy_Click" ToolTip="复制日志全文">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcCopy}" Width="13" Height="13"/>
                                    <TextBlock Text="复制" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnSmall}" Margin="8,0,0,0" Click="LogClear_Click" ToolTip="清空日志">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcClear}" Width="13" Height="13"/>
                                    <TextBlock Text="清空" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnSmall}" Margin="8,0,0,0" Click="LogFold_Click" ToolTip="收起日志面板">
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcChevD}" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource Brush.Sep}"/>
                    <RichTextBox x:Name="LogRt" Grid.Row="2" Margin="14,10,10,12" Background="Transparent"
                                 Foreground="{DynamicResource Brush.LogText}"
                                 FontFamily="Consolas" FontSize="12" BorderThickness="0"
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <Border x:Name="LogCap" Height="40" CornerRadius="12" Padding="0"
                    MouseLeftButtonDown="LogHeader_Click" Cursor="Hand"
                    Background="{DynamicResource Brush.GlassStrong}"
                    BorderBrush="{DynamicResource Brush.GlassEdge}" BorderThickness="1">
                <Grid Margin="14,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="BusyRing" Style="{StaticResource Ico}" Data="{StaticResource IcArc}"
                              Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2.4" Width="16" Height="16"
                              Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="BusySpin"/>
                            </Path.RenderTransform>
                        </Path>
                        <Path x:Name="LogIcon" Style="{StaticResource Ico}" Data="{StaticResource IcCopy}" Width="14" Height="14"/>
                        <TextBlock Text="运行日志" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="●" FontSize="11" Foreground="{DynamicResource Brush.Text3}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LbLogSub" FontSize="12.5" Foreground="{DynamicResource Brush.Text2}"
                                   Margin="7,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="300" Text="就绪"/>
                        <TextBlock x:Name="PctText" Style="{StaticResource Cap}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                    <Path x:Name="FoldIcon" Grid.Column="1" Style="{StaticResource Ico}" Data="{StaticResource IcChevU}"
                          Width="14" Height="14" Margin="10,0,0,0"
                          VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
