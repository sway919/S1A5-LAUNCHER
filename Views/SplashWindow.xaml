<!--
    ════════════════════════════════════════════════════════════════
    启动落地窗 (SplashWindow)

    【为什么需要它】
      主界面是一棵很重的视觉树 + 四份主题字典, 从双击到"主窗口真的画在屏幕上"
      要 4 秒上下 (实测拆解见 Core/AppSys.cs 的 BootMark 日志)。这段时间里
      用户看到的只有"没反应"。所以先弹这个窗口: 它【不引用任何主题字典】,
      XAML 只有十几行, 宿主一起步(约 0.8s)就能画出来。

    【它为什么不能卡住】
      后面 2~3 秒的重活 (解析主题字典、建主窗口) 都在 UI 线程上, 这个窗口
      期间无法重绘 —— 所以按钮/文字都是静态的, 只有右下角那根转圈是
      RotateTransform 上的独立动画, 由渲染线程接管, UI 线程被占住也照转。

    【它什么时候消失】
      主窗口 ContentRendered(第一帧画完) 之后才关, 不会露出没画完的主界面。
    ════════════════════════════════════════════════════════════════
-->
<Window x:Class="ServerUI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="S1A5 一键端 · 启动中"
        Width="440" Height="146"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True"
        Background="#12131A"
        FontFamily="Microsoft YaHei UI">
    <Border BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="22,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11"
                    Background="#1AFFFFFF" VerticalAlignment="Center" ClipToBounds="True">
                <Image x:Name="Brand" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Name="TitleText" Text="S1A5 单机一键端"
                           FontSize="16.5" FontWeight="Bold" Foreground="#F2F3F7"/>
                <TextBlock x:Name="SubText" Text="正在启动，请稍候…"
                           FontSize="12" Foreground="#9AA0AE" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- 转圈: RenderTransform 上的独立动画, UI 线程再忙也照转 -->
            <Path Grid.Column="2" x:Name="Spin" Data="M 8,0 A 8,8 0 1 1 0,8"
                  Stroke="#AEC6FF" StrokeThickness="2.4"
                  Width="17" Height="17" Stretch="None"
                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform x:Name="SpinRt"/>
                </Path.RenderTransform>
            </Path>
        </Grid>
    </Border>
</Window>
