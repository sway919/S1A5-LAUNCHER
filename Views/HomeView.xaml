<!--
    ════════════════════════════════════════════════════════════════
    首页 — 两块"浮在画上"的玻璃卡 (真实投影, 与背景分层)

      · 左下 信息板 (404×330): 下划线选项卡 [状态 / 快捷]
          - 状态: 只读读数, 行高随面板均分铺满 (服务端 / 服务端端口 / 存档 / 客户端 / A5.dll / Script.pvf / 网页GM)
          - 快捷: 打开各类目录 + A5.dll 补丁状态说明
      · 右下 指挥台: GM 工具 · 停止 · 重启 · 开始游戏
      · 底部: 运行日志胶囊 (主窗口) 悬在两卡之下
      · 日志胶囊正上方: 【闪屏修复】开关 (状态点 + Switch; 部署/撤下见 Services\FlickerFixService.cs,
        日志面板展开时自动让位)

    设计纪律: 青蓝 = 次级行动/选中, 金 = 唯一主行动; 不出现大面积白色实心块。
    ════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="ServerUI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Geometry x:Key="IcArc">M12 3.2 A8.8 8.8 0 0 1 20.8 12</Geometry>
    </UserControl.Resources>

    <Grid Margin="0,48,0,0">

        <!-- ════════════ 左下: 信息板 ════════════ -->
        <ContentControl x:Name="CardInfo" Style="{StaticResource FloatCard}" Width="404"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="108,0,0,84">
            <ContentControl.Resources>
                <!-- 面板正下方那片背景的实时采样 (代码里指向 BackdropHost 并设置 Viewbox) -->
                <VisualBrush x:Key="CardBackdrop" Stretch="Fill" TileMode="None"
                             ViewboxUnits="Absolute" ViewportUnits="RelativeToBoundingBox"
                             Viewport="0,0,1,1">
                    <VisualBrush.Viewbox>0,0,10,10</VisualBrush.Viewbox>
                </VisualBrush>
            </ContentControl.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="330"/>
                </Grid.RowDefinitions>

                <!-- 选项卡行 (下划线指示条) -->
                <Grid Margin="12,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <RadioButton x:Name="TabSt" Style="{StaticResource Tab}" GroupName="htab" Height="45"
                                     Content="状态" IsChecked="True" Checked="Tab_Changed"/>
                        <RadioButton x:Name="TabQk" Style="{StaticResource Tab}" GroupName="htab" Height="45"
                                     Content="快捷" Checked="Tab_Changed"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconBtn}" Width="32" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="ImportBg_Click"
                            ToolTip="导入背景图片（可多选；多张时可用屏幕两侧箭头轮播）">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcImage}" Width="15" Height="15"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource Brush.Sep}"/>

                <!-- 内容区 -->
                <Grid Grid.Row="2">

                    <!-- ★ 状态 ★
                         行用 * 均分铺满内容区 —— 固定行高会在末行下面留一段空带;
                         服务端端口行 (RowPort) 隐藏时把它的两行定义高度归零。 -->
                    <Grid x:Name="PnSt" Margin="8,6,6,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition x:Name="RowPortRow" Height="*"/>
                            <RowDefinition x:Name="SepPortRow" Height="1"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Height="40" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/><ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="D1" Width="7" Height="7" Fill="{DynamicResource Brush.Danger}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="服务端" Style="{StaticResource Txt2}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="V1" Grid.Column="2" Text="未运行" Style="{StaticResource Txt}" FontWeight="SemiBold"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Sep}" Margin="6,0"/>

                        <!-- 服务端端口: 游戏端口 + 网页 GM 端口。
                             只在【服务端未运行】时显示 —— 服务端起来之后它已经固定，留着只是占地方。 -->
                        <StackPanel x:Name="RowPort" Grid.Row="2">
                            <Grid Height="40" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/><ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="D7" Width="7" Height="7" Fill="{DynamicResource Brush.Text3}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="服务端端口" Style="{StaticResource Txt2}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="V7" Grid.Column="2" Text="-- / --" Style="{StaticResource Txt}"
                                           FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="前一个 = 游戏端口（客户端连它）；后一个 = 网页 GM 端口（浏览器访问 http://127.0.0.1:端口）。可在【设置 → 连接与账号】改"/>
                            </Grid>
                        </StackPanel>
                        <Border x:Name="SepPort" Grid.Row="3" Height="1" Background="{DynamicResource Brush.Sep}" Margin="6,0"/>

                        <Grid Grid.Row="4" Height="40" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/><ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="D2" Width="7" Height="7" Fill="{DynamicResource Brush.Warn}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="存档数据库" Style="{StaticResource Txt2}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="V2" Grid.Column="2" Text="--" Style="{StaticResource Txt}" FontWeight="SemiBold"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Border Grid.Row="5" Height="1" Background="{DynamicResource Brush.Sep}" Margin="6,0"/>

                        <Grid Grid.Row="6" Height="40" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/><ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="D3" Width="7" Height="7" Fill="{DynamicResource Brush.Danger}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="游戏客户端" Style="{StaticResource Txt2}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="V3" Grid.Column="2" Text="未配置" Style="{StaticResource Txt}" FontWeight="SemiBold"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Border Grid.Row="7" Height="1" Background="{DynamicResource Brush.Sep}" Margin="6,0"/>

                        <Grid Grid.Row="8" Height="40" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/><ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="D4" Width="7" Height="7" Fill="{DynamicResource Brush.Warn}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="A5.dll 补丁" Style="{StaticResource Txt2}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="V4" Grid.Column="2" Text="未部署" Style="{StaticResource Txt}" FontWeight="SemiBold"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Border Grid.Row="9" Height="1" Background="{DynamicResource Brush.Sep}" Margin="6,0"/>

                        <Grid Grid.Row="10" Height="40" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/><ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="D5" Width="7" Height="7" Fill="{DynamicResource Brush.Text3}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Script.pvf" Style="{StaticResource Txt2}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="V5" Grid.Column="2" Text="未检查" Style="{StaticResource Txt}"
                                       FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="客户端目录里的脚本数据包，服务端启动时要解析它，缺了服务端起不来"/>
                        </Grid>
                        <Border Grid.Row="11" Height="1" Background="{DynamicResource Brush.Sep}" Margin="6,0"/>

                        <Grid Grid.Row="12" Height="40" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/><ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="D6" Width="7" Height="7" Fill="{DynamicResource Brush.Text3}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="网页 GM" Style="{StaticResource Txt2}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="V6" Grid.Column="2" Text="未运行" Style="{StaticResource Txt}" FontWeight="SemiBold"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </Grid>

                    <!-- ★ 快捷 ★ -->
                    <ScrollViewer x:Name="PnQk" Visibility="Collapsed" Margin="16,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource BtnGlass}" Height="38" Margin="0,0,8,8" Click="OpenServerDir_Click"
                                        ToolTip="服务端包根目录（server\s1a5-*.jar / data\s1a5.db 所在处）">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcFolder}" Width="14" Height="14"/>
                                        <TextBlock Text="服务端目录" Style="{StaticResource Txt}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnGlass}" Height="38" Margin="0,0,0,8" Click="OpenClientDir_Click"
                                        ToolTip="游戏客户端目录（DNF.exe 所在处）">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcFolder}" Width="14" Height="14"/>
                                        <TextBlock Text="客户端目录" Style="{StaticResource Txt}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnGlass}" Height="38" Margin="0,0,8,8" Click="OpenDbDir_Click"
                                        ToolTip="存档所在目录（data\s1a5.db 三件套，也是网页 GM 自动备份 data\webgm-backups\ 的上级）">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcDb}" Width="14" Height="14"/>
                                        <TextBlock Text="存档目录" Style="{StaticResource Txt}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnGlass}" Height="38" Margin="0,0,0,8" Click="OpenLogDir_Click"
                                        ToolTip="服务端日志 logs\ 与启动器日志 runtime\logs\ ">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcCopy}" Width="14" Height="14"/>
                                        <TextBlock Text="日志目录" Style="{StaticResource Txt}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <Button Style="{StaticResource BtnGlass}" Height="38" Margin="0,0,0,8" Click="OpenBackupDir_Click"
                                    HorizontalContentAlignment="Left"
                                    ToolTip="启动器的存档备份目录（runtime\存档备份\，存档页的备份都在这里）">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcImport}" Width="14" Height="14"/>
                                    <TextBlock Text="备份目录" Style="{StaticResource Txt}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="{DynamicResource Brush.Sep}" Margin="0,14"/>

                            <TextBlock Text="A5.dll 客户端补丁" Style="{StaticResource Cap}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource Brush.FieldFill}" BorderBrush="{DynamicResource Brush.FieldBorder}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock x:Name="LblA5State" Text="--" Style="{StaticResource Txt}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Txt3}" TextWrapping="Wrap" LineHeight="19" Margin="0,5,0,0"
                                               Text="A5.dll 是客户端补丁：没有它，击杀怪物不会上报给服务端 —— 怪物的血打空也不会死。补丁随一键端发布，放进客户端目录即生效（与 DNF.exe 同层）。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- ════════════ 右下: 指挥台 (GM 工具 · 停止 · 重启 · 开始游戏) ════════════ -->
        <ContentControl x:Name="CardDeck" Style="{StaticResource FloatCard}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,84">
            <ContentControl.Resources>
                <!-- 面板正下方那片背景的实时采样 (代码里指向 BackdropHost 并设置 Viewbox) -->
                <VisualBrush x:Key="CardBackdrop" Stretch="Fill" TileMode="None"
                             ViewboxUnits="Absolute" ViewportUnits="RelativeToBoundingBox"
                             Viewport="0,0,1,1">
                    <VisualBrush.Viewbox>0,0,10,10</VisualBrush.Viewbox>
                </VisualBrush>
            </ContentControl.Resources>
            <StackPanel Orientation="Horizontal" Margin="14,8" VerticalAlignment="Center">

                <!-- GM 工具: 与【开始游戏】同级的大按钮 -->
                <Button x:Name="BtGm" Style="{StaticResource BtnAction}" Click="Gm_Click" VerticalAlignment="Center"
                        ToolTip="打开网页 GM">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.AccentSoft}"
                                BorderBrush="{DynamicResource Brush.AccentLine}" BorderThickness="1">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcWrench}" Width="18" Height="18"
                                  Stroke="{DynamicResource Brush.Accent}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                            <TextBlock Text="GM 工具" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock x:Name="LbGmSub" Text="未运行" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text3}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 停止服务端 (仅服务端运行中显示) -->
                <Button x:Name="BtStopRound" Style="{StaticResource IconBtn}" Width="42" Height="56" Margin="8,0,0,0"
                        Click="Stop_Click" VerticalAlignment="Center" Visibility="Collapsed"
                        Background="{DynamicResource Brush.FieldFill}"
                        BorderBrush="{DynamicResource Brush.FieldBorder}" BorderThickness="1"
                        ToolTip="停止服务端（先请求正常退出，让存档完成落盘）">
                    <Path Style="{StaticResource IcoFill}" Data="{StaticResource IcStop}"
                          Fill="{DynamicResource Brush.Danger}" Width="13" Height="13"/>
                </Button>

                <!-- 重启服务端: 先安全停止再启动, 不启动客户端 -->
                <Button x:Name="BtRestartRound" Style="{StaticResource IconBtn}" Width="42" Height="56" Margin="8,0,0,0"
                        Click="Restart_Click" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.FieldFill}"
                        BorderBrush="{DynamicResource Brush.FieldBorder}" BorderThickness="1"
                        ToolTip="重启服务端（先正常停止再启动，不会启动游戏客户端）">
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcRefresh}"
                          Stroke="{DynamicResource Brush.Warn}" Width="16" Height="16"/>
                </Button>

                <!-- 开始游戏: 全局唯一金色主按钮 (一键 = 启动服务端 + 进游戏) -->
                <Button x:Name="BtStart" Style="{StaticResource BtnStart}" Click="Start_Click"
                        VerticalAlignment="Center" Margin="10,0,0,0"
                        ToolTip="一键启动：先启动服务端（如未运行），再进入游戏">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="999" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.OnHero}">
                            <Grid>
                                <Path x:Name="StartIcon" Style="{StaticResource IcoFill}" Data="{StaticResource IcPlay}"
                                      Fill="{DynamicResource Brush.HeroFill}" Width="14" Height="14"/>
                                <Path x:Name="Spinner" Style="{StaticResource Ico}" Data="{StaticResource IcArc}"
                                      Stroke="{DynamicResource Brush.HeroFill}" StrokeThickness="2.4" Width="18" Height="18"
                                      Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinRt"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="StartTxt" Text="开始游戏" Margin="13,0,2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ContentControl>

        <!-- ════════════ 闪屏修复开关 (运行日志胶囊正上方; 日志面板展开时让位, 见 AppSys.LogExpandChanged) ════════════
             勾选 = 把随包的 防闪屏补丁\ (dgVoodoo2) 复制进客户端根目录, 解决闪屏;
             取消 = 撤下并恢复原状。逻辑在 Services\FlickerFixService.cs + Flows.ApplyFlickerFixAsync。 -->
        <Border x:Name="CardFlicker" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,26,218" Height="40" CornerRadius="12"
                Background="{DynamicResource Brush.GlassStrong}"
                BorderBrush="{DynamicResource Brush.GlassEdge}" BorderThickness="1"
                ToolTip="闪屏修复（dgVoodoo 补丁）&#x0a;勾选：自动把启动器旁边的【防闪屏补丁】文件夹复制进游戏客户端目录，解决进游戏后画面闪屏。&#x0a;取消勾选：移除补丁并恢复原文件。&#x0a;补丁文件夹要和启动器放在一起（找不到时会自动向上层找两级）。">
            <StackPanel Orientation="Horizontal" Margin="14,0,14,0" VerticalAlignment="Center">
                <Ellipse x:Name="Df" Width="7" Height="7" Fill="{DynamicResource Brush.Text3}" VerticalAlignment="Center"/>
                <TextBlock Text="闪屏修复" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <ToggleButton x:Name="TgFlicker" Style="{StaticResource Switch}" Margin="14,0,2,0"
                              VerticalAlignment="Center"
                              Checked="FlickerFix_Toggled" Unchecked="FlickerFix_Toggled"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
