<!--
    ════════════════════════════════════════════════════════════════
    插件详情弹窗 —— DLL 扩展页【详细】按钮

    列表行塞不下完整说明（只有一句话小字），这里展示全部元数据：
    说明 / 注意事项 / 版本 / 作者 / 主页 / 说明来源。
    元数据来自 DllExtService.ResolveMeta 的四级回退链
    （随件 .plugin.json → 启动器内置目录 → 文件属性 → 默认文案），
    本窗不碰 dll_ext.ini、也绝不 LoadLibrary 插件。
    窗口样式照 DlgWindow（无边框玻璃卡 + Esc 关闭 + 打开时压暗主界面）。
    ════════════════════════════════════════════════════════════════ -->
<Window x:Class="ServerUI.Views.DllExtDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/icon128.png"
        AutomationProperties.AutomationId="DllExtDetailWindow"
        Title="插件详情" Width="580" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource Brush.GlassStrong}"
        FontFamily="Microsoft YaHei UI" MouseLeftButtonDown="Win_Drag">

    <Grid>
        <Border CornerRadius="12" Background="{DynamicResource Brush.GlassStrong}"
                BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="1">
            <Grid Margin="28,0,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题行: 图标 + 名称 + 关闭 -->
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="IconCircle" Width="40" Height="40" CornerRadius="999" VerticalAlignment="Center">
                            <Path x:Name="IconPath" Style="{StaticResource Ico}" Data="{StaticResource IcChip}"
                                  Width="19" Height="19"/>
                        </Border>
                        <TextBlock x:Name="LbTitle" Style="{StaticResource H2}" FontSize="20"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text="--"/>
                    </StackPanel>
                    <Button Style="{StaticResource WinBtnClose}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="36" Height="30" Click="Close_Click"/>
                </Grid>

                <!-- 正文 -->
                <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="LbFile" Style="{StaticResource Txt3}" TextWrapping="Wrap" Text="--"/>
                        <Border Background="{DynamicResource Brush.Sep}" Height="1" Margin="0,12,0,12"/>

                        <TextBlock Text="说明" Style="{StaticResource Txt2}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LbSummary" Style="{StaticResource Txt2}" TextWrapping="Wrap" Margin="0,5,0,0"
                                   LineHeight="20" Text="--"/>

                        <StackPanel x:Name="PnNotes" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock Text="注意事项" Style="{StaticResource Txt2}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LbNotes" Style="{StaticResource Txt3}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       LineHeight="19" Text="--"/>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="版本" Style="{StaticResource Txt3}"/>
                            <TextBlock x:Name="LbVersion" Grid.Column="1" Style="{StaticResource Txt3}" Text="--"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="LbAuthorHead" Grid.Row="1" Text="作者" Style="{StaticResource Txt3}"/>
                            <TextBlock x:Name="LbAuthor" Grid.Row="1" Grid.Column="1" Style="{StaticResource Txt3}" Text="--"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="LbHomeHead" Grid.Row="2" Text="主页" Style="{StaticResource Txt3}"/>
                            <TextBlock x:Name="LbHomepage" Grid.Row="2" Grid.Column="1" Style="{StaticResource Txt3}" Text="--"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Text="说明来源" Style="{StaticResource Txt3}"/>
                            <TextBlock x:Name="LbSource" Grid.Row="3" Grid.Column="1" Style="{StaticResource Txt3}" Text="--"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Border Background="{DynamicResource Brush.Sep}" Height="1" Margin="0,14,0,12"/>
                        <TextBlock Style="{StaticResource Txt3}" TextWrapping="Wrap" LineHeight="19"
                                   Text="说明随插件文件提供：随件的 &lt;插件名&gt;.plugin.json（作者写的，信息最全）、启动器内置目录（按文件 md5 命中）或 DLL 自己的文件属性；都没有时显示默认提示。启动器只读文件、只解析说明，从不加载插件本体。"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 按钮组 -->
                <StackPanel x:Name="BtnBar" Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="BtOpenDir" Style="{StaticResource BtnGlass}" Content="打开扩展目录"
                            MinWidth="120" Click="OpenDir_Click"/>
                    <Button Style="{StaticResource BtnAction}" Content="关闭" MinWidth="100" Margin="10,0,0,0"
                            IsDefault="True" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
