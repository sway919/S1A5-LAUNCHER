<Application x:Class="ServerUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ServerUI.Core">
    <!-- 注意: 这里【不写】StartupUri —— 主窗口由 App.OnStartup 里手工建, 见 App.xaml.cs。 -->

    <!--
        【这里【故意】不写 MergedDictionaries —— 为了启动快, 别加回去】
        这四份字典 (Fluent/Brushes/Controls/Icons) 合计约 1300 行 XAML, 首次解析
        要 ~0.9 秒, 而它发生在 Main() 里 app.InitializeComponent() 期间 —— 也就是
        OnStartup 之前。启动落地窗(SplashWindow)必须赶在这 0.9 秒之前弹出来,
        所以字典不在 App.xaml 里加载, 改由 App.OnStartup 在落地窗显示之后再装
        (Core/AppSys.EnsureThemeDictionaries)。

        注意: 这里【不能】写 ThemeMode="Dark"。
        那是 .NET 9+ WPF 的官方 Fluent 主题属性, 在 net48 (实际分发目标) 上会导致
        XAML 编译失败。明暗主题由 AppSys.ApplyTheme() 切换自己的 Themes\ 字典实现,
        与官方主题无关; Themes\Fluent.*.xaml 在 net48 下只是未被使用的令牌定义,
        保留是为了将来回到 net10 时不用重新找回这套覆盖。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
